# Copie este arquivo para .env e preencha. NUNCA faça commit do .env.

# --- Banco de dados (PostgreSQL) ---
# Para desenvolvimento local use o docker compose (veja README) e uma base SEPARADA da produção.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=youngdreamdata
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Autenticação ---
# Mínimo de 32 caracteres aleatórios. Gere com:  openssl rand -hex 32
JWT_SECRET=
